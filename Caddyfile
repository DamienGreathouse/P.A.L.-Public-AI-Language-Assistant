# ── Global block — applies to every site below ──
# ACME account contact email (required by the CA; usually Let's Encrypt).
email youremail@domain.com

# Obtain/renew certificates via Cloudflare DNS-01 challenge.
# The token is read from the CLOUDFLARE_API_TOKEN env var in docker-compose.yml.
# (Required if the caddy-cloudflare image does not auto-configure it.)
acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}

# ── Open WebUI (public) ──
pal.yourdomain.com {
    reverse_proxy open-webui:8080
}

# ── Docling (document parsing, public) ──
docling.yourdomain.com {
    reverse_proxy docling-serve:5001
}
